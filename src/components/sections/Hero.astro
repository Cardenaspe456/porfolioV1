---
import { Image } from 'astro:assets';
import architecture from '../../assets/blueprints/arquitectura-web.webp';
import code from '../../assets/tabler/code.svg';
import components from '../../assets/tabler/components.svg';
import click from '../../assets/tabler/click.svg';
import arrow from '../../assets/tabler/arrow-right.svg';

const capabilities = [
  { title: 'Desarrollo frontend', description: 'Interfaces claras, adaptables y accesibles.', icon: code },
  { title: 'Diseño de interfaces', description: 'De la primera estructura al último detalle.', icon: components },
  { title: 'Experiencias digitales', description: 'Interacciones con intención y propósito.', icon: click },
];
---
<section id="inicio" class="hero container" aria-labelledby="hero-title">
  <div class="hero-spread">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker">Diseño + código + criterio</p>
      <h1 id="hero-title">Ideas claras.<br />Experiencias<br /><span>bien construidas.</span></h1>
      <p class="hero-summary">Desarrollo interfaces que conectan diseño y tecnología. Productos digitales pensados para las personas, construidos con atención al detalle.</p>
      <div class="hero-actions">
        <a class="button" href="#proyectos">Explorar proyectos <img src={arrow.src} width="17" height="17" alt="" /></a>
        <a class="text-link" href="#contacto">Hablemos de tu idea</a>
      </div>
    </div>
    <figure class="hero-plate">
      <figcaption class="plate-heading"><strong>Arquitectura web</strong><span>ED. 001 / 2026</span></figcaption>
      <Image class="hero-drawing" src={architecture} alt="Vista en despiece de una aplicación web con la interfaz, la capa de servicios y la base de datos alineadas." widths={[480, 720, 1020, 1440]} sizes="(max-width: 800px) 100vw, 50vw" loading="eager" fetchpriority="high" />
      <ol class="plate-legend" aria-label="Capas del plano">
        <li><span>01</span> Interfaz</li>
        <li><span>02</span> Servicios</li>
        <li><span>03</span> Datos</li>
      </ol>
    </figure>
  </div>
  <div class="capability-strip" aria-label="Áreas de enfoque">
    {capabilities.map(({ title, description, icon }) => (
      <div class="capability">
        <img src={icon.src} width="25" height="25" alt="" />
        <div><h2>{title}</h2><p>{description}</p></div>
      </div>
    ))}
  </div>
</section>

---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { Image } from 'astro:assets';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project }
const { project } = Astro.props;
const next = projects[(projects.findIndex(item => item.slug === project.slug) + 1) % projects.length];
---
<PortfolioLayout title={`${project.title} — DEV.`} description={project.summary}>
  <article class="case-study container">
    <nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/#proyectos">Proyectos</a><span>/</span><span>{project.title}</span></nav>
    <p class="eyebrow">Estudio {project.number} / {project.category}</p>
    <h1>{project.title}</h1>
    <p class="case-summary">{project.summary}</p>
    <p class="example-label">Caso de estudio de ejemplo · No representa un trabajo realizado</p>
    <dl class="case-meta"><div><dt>Participación propuesta</dt><dd>{project.role}</dd></div><div><dt>Tecnologías de ejemplo</dt><dd>{project.technologies.join(' / ')}</dd></div><div><dt>Estado</dt><dd>Concepto de portafolio</dd></div></dl>
    <figure class="case-image">
      <figcaption class="plate-heading"><strong>{project.drawingCaption}</strong><span>Plano / {project.number}</span></figcaption>
      <Image src={project.drawing} alt={project.drawingAlt} widths={[480, 720, 1080, 1440]} sizes="(max-width: 800px) 100vw, 900px" />
    </figure>
    <div class="case-content"><section><p class="eyebrow">01 / Contexto</p><h2>El problema</h2><p>{project.problem}</p></section><section><p class="eyebrow">02 / Enfoque</p><h2>La solución</h2><p>{project.solution}</p></section><section><p class="eyebrow">03 / Proceso</p><h2>Decisiones clave</h2><ul>{project.decisions.map(decision => <li>{decision}</li>)}</ul></section><section><p class="eyebrow">04 / Aprendizaje</p><h2>Resultados y próximos pasos</h2><p>{project.result}</p><p class="muted">Demo y repositorio: pendientes de añadir.</p></section></div>
    <div class="case-navigation"><a class="text-link" href="/#proyectos">Volver a proyectos</a><a class="button" href={`/proyectos/${next.slug}/`}>Siguiente: {next.title}</a></div>
  </article>
</PortfolioLayout>
